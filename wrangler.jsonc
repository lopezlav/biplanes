{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biplanes",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "MATCH", "class_name": "Match" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Lobby", "Match"] }
  ],
  "routes": [
    { "pattern": "biplanes.chope.dev", "custom_domain": true }
  ]
}
